# Isole chaque étudiant des autres sur le réseau de la salle : la découverte
# DDS est restreinte à la machine locale, donc pas de collision entre deux
# ROS_DOMAIN_ID identiques sur le même réseau. Pas de `use flake .` ici : le
# devshell ROS est trop gros pour direnv (DIRENV_DIFF dépasse MAX_ARG_STRLEN,
# "Argument list too long" sur tous les exec). Lancer `nix develop` à côté.
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
export ROS_DOMAIN_ID=14
